---
layout: base.njk
title: Organizing Committee
description: The Organizing Committee of the International Summit for Western Civilization.
permalink: /committee/
---
{% set s = collections.summits | current(site.currentYear) %}
<section class="page-head" style="--img:url('{{ '/assets/img/art/capitol.jpg' | url }}')">
  <div class="wrap">
    <p class="eyebrow light">{{ s.data.edition }} Summit · {{ s.data.dateText }}</p>
    <h1>Organizing Committee</h1>
    <p class="page-sub">The people preparing the Summit</p>
  </div>
</section>
<section class="section committee-section">
  <div class="wrap">
    <ol class="committee">
      {% for m in committee.members %}
      <li class="member{% if m.role %} member-chair{% endif %} reveal">
        {% set parts = m.name.split(" ") %}
        <div class="member-photo">{% if m.photo %}<img src="{{ m.photo | url }}" alt="{{ m.name }}" width="120" height="150" loading="lazy">{% else %}<div class="member-mono" aria-hidden="true">{{ parts[0][0] }}{{ parts[parts.length - 1][0] }}</div>{% endif %}</div>
        <div class="member-id">
          {% if m.role %}<p class="member-role">{{ m.role }}</p>{% endif %}
          <h2>{{ m.name }}</h2>
        </div>
        <div class="member-body">
          <p class="member-short">{{ m.bio }}</p>
          {% if m.full %}<details class="member-more"><summary><span class="more-open">Full biography</span><span class="more-close">Show less</span><span class="sr">, {{ m.name }}</span></summary><p>{{ m.full }}</p></details>
          {% elif m.link %}<p class="speaker-link"><a href="{{ m.link }}" target="_blank" rel="noopener">Full biography<span class="sr">, {{ m.name }}</span></a></p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
    <p class="center mt"><a class="btn btn-gold" href="{{ '/program/' | url }}">View the Program</a></p>
  </div>
</section>

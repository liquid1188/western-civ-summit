<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != site.name %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  {% if site.setupMode %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="{{ site.origin }}{{ '/assets/img/og.jpg' | url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <script>document.documentElement.classList.add("js")</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,400;1,500&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header" id="siteHeader">
    <div class="progress" id="progress" aria-hidden="true"></div>
    <div class="wrap header-inner">
      <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.name }}, home">
        <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><use href="#column"/></svg>
        <span class="brand-text"><span>International Summit</span><em>for Western Civilization</em></span>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav"><span></span><span></span><span class="sr">Menu</span></button>
      <nav id="nav" class="nav">
        {% set links = [["/", "Home"], ["/program/", "Program"], ["/archive/", "Speeches & Media"], ["/contact/", "Contact"]] %}
        {% for l in links %}<a href="{{ l[0] | url }}"{% if page.url == l[0] %} aria-current="page"{% endif %}>{{ l[1] }}</a>{% endfor %}
        <a class="btn btn-gold" href="{{ '/register/' | url }}">Attend</a>
      </nav>
    </div>
  </header>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="column" viewBox="0 0 40 40">
      <path fill="currentColor" d="M5 6h30v3H5zM8 10h24l-2 3H10zM11 14h2v18h-2zM16 14h2v18h-2zM22 14h2v18h-2zM27 14h2v18h-2zM9 33h22v2H9zM6 36h28v2H6zM7 3h26l2 2H5z"/>
    </symbol>
    <symbol id="orn" viewBox="0 0 160 16">
      <g fill="none" stroke="currentColor" stroke-width="1"><path d="M0 8h62M98 8h62"/><path d="M80 2l6 6-6 6-6-6z"/><path d="M68 8l3-3 3 3-3 3zM86 8l3-3 3 3-3 3z"/></g>
    </symbol>
  </svg>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <svg class="orn" viewBox="0 0 160 16" aria-hidden="true"><use href="#orn"/></svg>
      <p class="footer-motif">Athens · Rome · Jerusalem</p>
      <p class="footer-title">International Summit <em>for</em> Western Civilization</p>
      <p class="footer-tag">Natural law, human dignity, and the renewal of Western Civilization. Washington, D.C.</p>
      <nav class="footer-nav">
        <a href="{{ '/program/' | url }}">{{ site.currentYear }} Program</a>
        <a href="{{ '/register/' | url }}">Request to Attend</a>
        <a href="{{ '/archive/' | url }}">Speeches &amp; Media</a>
        <a href="{{ '/contact/' | url }}">Contact</a>
        <a href="{{ '/privacy/' | url }}">Privacy</a>
      </nav>
    </div>
    <div class="wrap footer-base">
      <span>© {{ site.currentYear }} {{ site.name }}</span>
      <span><button type="button" class="desktop-toggle" id="desktopToggle">View desktop version</button><span class="dt-sep"> · </span><a href="https://lickitysplitweb.com" rel="noopener">Site by Lickity Split Web Design</a></span>
    </div>
  </footer>
  {% if site.registrationOpen and page.url != "/register/" and page.url != "/thank-you/" %}
  {% set cs = collections.summits | current(site.currentYear) %}
  <div class="sticky-cta" id="stickyCta" hidden>
    <span><b>{{ cs.data.dateText }}</b>{{ cs.data.location }}</span>
    <a class="btn btn-gold btn-sm" href="{{ '/register/' | url }}">Request to Attend</a>
  </div>
  {% endif %}
  <script src="{{ '/assets/js/main.js' | url }}"></script>
  {% if site.cloudflareAnalyticsToken %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareAnalyticsToken }}"}'></script>{% endif %}
</body>
</html>
